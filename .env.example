# Public ElevenLabs agent id, e.g. agent_7101k5zvyjhmfg983brhmhkd98n6
# Public agents need no API key: the browser connects with the id alone.
# Leave unset to play human-only. The voice panel is switched off for now by
# SHOW_VOICE_AGENT in src/App.tsx; the id only matters once that is true.
VITE_ELEVENLABS_AGENT_ID=

# Optional: read the agent's announcements aloud in an ElevenLabs voice instead
# of the browser's own. A text-to-speech API key, read on the server only: the
# page asks /api/speak (api/speak.ts, a Vercel function that the dev server
# serves too) and never sees the key. No VITE_ prefix, so it stays out of the
# bundle. On Vercel add it as a Secret environment variable and redeploy.
ELEVENLABS_API_KEY=
# Optional overrides. Defaults: George (JBFqnCBsd6RMkjVDRZzb), eleven_flash_v2_5.
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=
